# syntax=docker/dockerfile:1.7
#
# Navigator runner — an amd64 developer toolchain with a dependency-warm Rust
# target cache. This is deliberately not a service image: the job controller
# supplies the command and first fetches the exact requested source ref into
# its worktree. `/workspace` is a cache seeded from the image build, never the
# authority for a job's source.

FROM rust:1.97-bookworm AS planner

WORKDIR /workspace

# cargo-chef's recipe contains Cargo's dependency graph without workspace
# source. Pin the tool and use its packaged lockfile so this build-time tool is
# reproducible rather than resolving an unconstrained latest release.
RUN cargo install cargo-chef --version 0.1.73 --locked

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
# cargo metadata validates each member's targets while deriving the recipe.
# The recipe itself contains only dependency metadata, so the subsequent cook
# layer stays reusable when ordinary workspace source changes.
COPY . ./

RUN cargo chef prepare --recipe-path recipe.json

FROM rust:1.97-bookworm AS runner

ARG TARGETARCH
ARG CHROME_FOR_TESTING_VERSION=150.0.7871.46
ARG NODE_VERSION=24.18.0
ARG CLAUDE_CODE_VERSION=2.1.220
ARG CARGO_LLVM_COV_VERSION=0.8.7

RUN test "$TARGETARCH" = amd64 \
    || (echo "navigator-runner is amd64-only" >&2; exit 1)

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        # `cargo chef cook --tests` compiles `libz-ng-sys`, whose build
        # script shells out to cmake (deploy run 142339796 was the first
        # build of this image and failed on the missing binary).
        cmake \
        curl \
        git \
        libasound2 \
        libgbm1 \
        libgtk-3-0 \
        libnss3 \
        libx11-xcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libxshmfence1 \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && rustup component add rustfmt clippy llvm-tools-preview

# The harness calls the pinned Claude Code CLI directly. Download Node from
# its immutable release path rather than inheriting Debian's moving package,
# then pin both the agent binary and coverage tool just as the Rust toolchain
# and browser pair are pinned below.
RUN curl --fail --show-error --location \
        "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
        --output /tmp/node.tar.xz \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && npm install --global "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && cargo install cargo-llvm-cov --version "${CARGO_LLVM_COV_VERSION}" --locked

# The versioned Chrome for Testing URLs carry the browser and its exact-match
# ChromeDriver and the tools used by the Rust verification gate.
RUN cft_base="https://storage.googleapis.com/chrome-for-testing-public/${CHROME_FOR_TESTING_VERSION}/linux64" \
    && curl --fail --show-error --location "${cft_base}/chrome-linux64.zip" --output /tmp/chrome.zip \
    && curl --fail --show-error --location "${cft_base}/chromedriver-linux64.zip" --output /tmp/chromedriver.zip \
    && unzip -q /tmp/chrome.zip -d /opt/chrome-for-testing \
    && unzip -q /tmp/chromedriver.zip -d /opt/chrome-for-testing \
    && rm /tmp/chrome.zip /tmp/chromedriver.zip

ENV CHROME_BINARY=/opt/chrome-for-testing/chrome-linux64/chrome \
    NAVIGATOR_CHROME_CACHE_DIR=/opt/chrome-for-testing \
    PATH=/opt/chrome-for-testing/chromedriver-linux64:${PATH}

WORKDIR /workspace

COPY --from=planner /usr/local/cargo/bin/cargo-chef /usr/local/cargo/bin/cargo-chef
COPY --from=planner /workspace/recipe.json recipe.json
RUN cargo chef cook --tests --recipe-path recipe.json

# Keep this list explicit. cli::devx's drift guard reads it against the root
# workspace manifest so a new member cannot make the runner image fail only at
# build time. The baked checkout warms Cargo; the job controller replaces it
# with the exact requested ref before executing any agent command.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY rules             rules
COPY store             store
COPY repos             repos
COPY import            import
COPY cli               cli
COPY LICENSE        LICENSE
COPY NOTICE         NOTICE
COPY THIRD-PARTY-NOTICES.txt THIRD-PARTY-NOTICES.txt
COPY portal            portal
COPY server            server
COPY neon              neon
COPY webapp            webapp
COPY views             views
COPY README.md         README.md
COPY telemetry         telemetry
COPY github_webhooks   github_webhooks
COPY forms             forms
COPY workflows         workflows
COPY workflows-service workflows-service
COPY github-runner     github-runner
COPY gateway           gateway
COPY cloud             cloud
COPY mcp               mcp
COPY features          features
COPY lsp               lsp
COPY live-inquiry      live-inquiry
COPY pdf               pdf
COPY templates         templates
COPY archives          archives
COPY billing           billing
COPY billing-workflows billing-workflows
COPY docs              docs
COPY k8s               k8s
COPY examples          examples

# The controller replaces this checkout with the immutable requested ref for
# each task. Baking the CLI and workspace crates here therefore warms the
# compiler cache without treating this source snapshot as task authority.
RUN cargo build --locked -p cli \
    && cargo build --locked -p github_webhooks --bin triage-runner \
    && install -m 0755 target/debug/navigator /usr/local/bin/navigator \
    && install -m 0755 target/debug/triage-runner /usr/local/bin/triage-runner

# The copied checkout is a local cache only. Before running a task, the DevX
# controller replaces it with the requested immutable Git ref; `cargo chef
# cook` above leaves the registry and dependency target artifacts warm.

CMD ["bash"]
