# Neon Law Navigator — environment variables (canonical reference)
#
# Every variable the workspace reads, grouped by subsystem. Copy this
# file to `.env`, fill in the blanks for your deployment, and run any
# Neon Law Navigator binary — `dotenvy::dotenv()` is wired into `web`, `cli`,
# the `navigator` CLI, `workflows-service`, and `archives` so the values are
# picked up automatically.
#
# Inventory (every key is documented at its owning subsystem below):
#   - Deployment selectors and credential fences.
#   - Web / worker runtime wiring: database, storage lanes, HTTP, OIDC,
#     policy, durable workflows, repositories, branding, and telemetry.
#   - Optional capabilities: email threading, DocuSign, Xero, forges,
#     Vertex AI, Solana, archives, billing diagnostics, and DNS.
#   - Operator orchestration: KIND, GCP provisioning, and production ship.
#   - Explicit test and sandbox seams. The Operating Navigator workshop's
#     Environment Matrix groups every startup key by process and lifecycle;
#     this file remains the detailed per-variable reference.
#
# Conventions:
#   - Variables marked `# (secret)` MUST NOT be committed. The repo's
#     `.gitignore` excludes `.env`, `.env.*`, and `dist-oss/` already.
#   - Deployment requirements are checked by
#     `web::config::enforce_deployment_invariants` at startup; missing values
#     crash the binary loudly instead of silently degrading.
#   - Variables marked `# (optional)` have sensible defaults documented
#     next to them.
#   - Anywhere you see `YOUR_*`, substitute your own identifier.
#   - Third-party API integrations (DocuSign e-signature today; Xero
#     accounting/billing next) use a SEPARATE vendor account per
#     environment. A normal dev deployment requires the real non-production
#     SendGrid configuration and DocuSign demo credentials. Only
#     NAVIGATOR_CI_HARNESS=1 may select captured/fake providers.
#
# For a guided walk-through of provisioning a fresh GCP project against
# this file, see `docs/oss-install.md`. For other clouds, see
# `docs/multi-cloud.md`.
#
# PRODUCTION SECRETS: deployment coordinates live in
# `deployments/<name>/config.toml` and key material in that deployment's
# SOPS-encrypted `secrets.enc.yaml`, applied to Secret Manager by
# `navigator ops secrets apply`. This file remains the canonical committed
# contract. Local KIND development uses `.devx/env`; optional live sandbox
# integrations may use a gitignored `.env`. See `docs/deployment-secrets.md`.

# ---------------------------------------------------------------------
# Deployment profile — exact and intentionally narrow
# ---------------------------------------------------------------------

# Exact `dev` selects the one non-production development profile shared by
# local KIND and the cloud staging lane. Exact `production`, empty, or unset
# selects production. Every other value — `staging`, `test`, a case variant,
# or one with surrounding whitespace — is rejected. "Staging" is only a
# Kubernetes deployment-lane name, never an application environment value.
# The selector is environment-blind for the canonical seed applied at boot;
# whether the simulated-matter fixture is applied on top is decided by
# NAVIGATOR_SIMULATED_MATTERS below.
NAVIGATOR_ENVIRONMENT=

# Whether this deployment's matters are simulated rather than real. A
# deployment that carries simulated matters seeds the three fixture matters
# (`donut-litigation`, `widget-works`, `montgomery-estate`) and publishes a
# site-wide banner telling every visitor that nothing they are looking at is a
# real client's file.
#
# Unset or empty follows NAVIGATOR_ENVIRONMENT: a `dev` boot carries simulated
# matters because that is all a `dev` boot has, and a `production` boot does
# not. Exactly `true` or `false` overrides that in both directions; every other
# value is rejected rather than resolved to the permissive answer.
#
# The override that matters is `true` under a `production` profile, which is
# what the persistent staging deployment is. Staging runs the production
# runtime profile deliberately — so the application it proves is the one
# production runs — and its data plane is the only synthetic thing about it.
# Nothing in the process can tell that apart from real production, so staging
# says so in its own `deployments/neon-law-stg/config.toml`. It is a
# coordinate, not a credential: it does not belong in `secrets.enc.yaml`.
NAVIGATOR_SIMULATED_MATTERS=

# Explicit exception for automated tests that need fake/capturing
# integrations (this `dev`-plus-harness combination is the Test operating
# mode). Production rejects this flag. Ordinary development and the cloud
# staging lane leave it unset and use real non-production credentials.
NAVIGATOR_CI_HARNESS=

# ---------------------------------------------------------------------
# Database — SurrealDB
# ---------------------------------------------------------------------

# The store. The scheme selects the topology: `ws://` for the local KIND pod
# through its port-forward, `wss://` for Surreal Cloud. `dev up` and
# `dev worktree-env up` write all five keys into `.devx/env`.
# Local KIND: `ws://localhost:18000`
NAVIGATOR_SURREAL_ENDPOINT=

# Namespace and database inside that engine — one coordinate pair per
# environment. Local KIND: `navigator` / `navigator`.
NAVIGATOR_SURREAL_NAMESPACE=
NAVIGATOR_SURREAL_DATABASE=

# Root credentials. Every Navigator process signs in as root: Surreal's
# per-table PERMISSIONS are explicitly NONE because authorization lives
# above the database, in persons.role + participation + embedded Rego (#1145, and
# docs/access-model.md). Local KIND uses `root` / `root`; a deployed
# engine must not. # (secret)
NAVIGATOR_SURREAL_USER=
NAVIGATOR_SURREAL_PASSWORD=

# ---------------------------------------------------------------------
# Object storage — GCS, Garage/S3-compatible, or local filesystem
# ---------------------------------------------------------------------

# Required — there is no default. `fs` for a local directory (dev), `gcs`
# for Google Cloud Storage or any GCS-compatible API. The `gcs` backend
# speaks the GCS REST API, so Garage uses the S3 backend with SigV4
# credentials issued by the KIND bootstrap. Leaving this unset is an error
# rather than an implicit `fs`, so a process never quietly writes objects to
# a local disk nothing else reads.
NAVIGATOR_STORAGE_BACKEND=fs

# Private documents bucket — `web` writes client `blobs/<sha>` here.
# Preferred over NAVIGATOR_STORAGE_BUCKET below; if set, it wins. Keep
# this distinct from the public NAVIGATOR_ASSETS_BUCKET so confidential
# client documents never land in a publicly-readable bucket. By
# convention `<project>-documents`. No `gs://` prefix.
# NAVIGATOR_DOCUMENTS_BUCKET=YOUR_PROJECT_ID-documents

# Private applications bucket — each Project's published client-portal
# bundle lives here at `<project-code>/portal/`, and `web` streams it
# through Axum at `/app/projects/{code}/portal`. Private and never public:
# the bytes are streamed same-origin so the session cookie and
# participation gate stay on every request. By convention
# `<project>-applications`. No `gs://` prefix.
# NAVIGATOR_APPLICATIONS_BUCKET=YOUR_PROJECT_ID-applications

# Generic bucket name (required when backend=gcs and
# NAVIGATOR_DOCUMENTS_BUCKET is unset). The fallback the `archives`
# cron and the KIND / navigator dev loops point at their own bucket. For
# GCS, this is just the bucket — no `gs://` prefix.
NAVIGATOR_STORAGE_BUCKET=

# The long-term Iceberg archive of this deployment's Surreal store, and the
# 90-day telemetry landing zone the nightly lane promotes into it. Read by
# `navigator ops gcp setup`, which creates each bucket, applies the telemetry
# expiry, and grants this deployment's runtime identity objectUser on both.
#
# Neither name derives from the project id: the archive is prefix-shaped
# (`neon-law-archives-<deployment>`), in the dedicated archives project rather
# than in the deployment's own — an archive outlives the cluster that wrote it.
# Leave both unset to provision the original four buckets and nothing else.
# NAVIGATOR_ICEBERG_BUCKET=neon-law-archives-YOUR_DEPLOYMENT
# NAVIGATOR_TELEMETRY_BUCKET=YOUR_DEPLOYMENT-telemetry

# Override the endpoint for Garage or another S3-compatible gateway.
# Leave unset to talk to real GCS.
# NAVIGATOR_STORAGE_ENDPOINT=http://garage.navigator.svc.cluster.local:3900

# S3/Garage credentials (required when NAVIGATOR_STORAGE_BACKEND=s3).
# Inject from Kubernetes Secrets in KIND/deploy; never commit real values.
# NAVIGATOR_STORAGE_REGION=garage
# NAVIGATOR_STORAGE_ACCESS_KEY=
# NAVIGATOR_STORAGE_SECRET_KEY=
# NAVIGATOR_STORAGE_SESSION_TOKEN=

# Optional lane-specific S3 credentials. Each falls back to the generic
# pair above when unset. KIND gives assets, applications, Git LFS, and
# exports separate Garage keys so one lane cannot read another lane's bucket.
# NAVIGATOR_ASSETS_ACCESS_KEY=
# NAVIGATOR_ASSETS_SECRET_KEY=
# NAVIGATOR_APPLICATIONS_ACCESS_KEY=
# NAVIGATOR_APPLICATIONS_SECRET_KEY=
# NAVIGATOR_LFS_ACCESS_KEY=
# NAVIGATOR_LFS_SECRET_KEY=
# NAVIGATOR_EXPORTS_ACCESS_KEY=
# NAVIGATOR_EXPORTS_SECRET_KEY=

# Dedicated Git LFS bucket for S3/Garage deployments.
# NAVIGATOR_LFS_BUCKET=navigator-lfs

# Filesystem root (required when backend=fs). Relative paths resolve
# against the binary's working directory.
NAVIGATOR_STORAGE_FS_ROOT=./var/storage

# ---------------------------------------------------------------------
# Google Workspace Drive — one internal Projects drive per entity
# ---------------------------------------------------------------------

# Every Project has an internal working folder in its deployment-owned Google
# Workspace map. The Drive service account is separate for each Workspace and has
# domain-wide delegation; the delegated user is a Workspace administrator or
# other user authorized to manage that Workspace's shared drive. Supply the
# full service-account JSON through the deployment's secrets.enc.yaml /
# Secret Manager, never a path or a committed plaintext key. `cloud::WorkspaceConfig` resolves the active deployment from
# `NAVIGATOR_GCP_PROJECT_ID`, so an unrecognized deployment cannot borrow
# another deployment's Drive root or repository organizations.
#
# The shared Drive ID names the enclosing Drive. Each deployment supplies its
# own Projects-root folder ID within it: production and staging are separate
# roots inside the one firm-controlled Workspace.
# Folder IDs are durable coordinates; the service-account JSON is secret key
# material. An optional machine-local mount is never deployed as a credential.
NAVIGATOR_DRIVE_NEON_LAW_PROJECTS_DRIVE_ID=
NAVIGATOR_DRIVE_NEON_LAW_PRODUCTION_PROJECTS_ROOT_FOLDER_ID=
NAVIGATOR_DRIVE_NEON_LAW_STAGING_PROJECTS_ROOT_FOLDER_ID=
NAVIGATOR_DRIVE_NEON_LAW_DELEGATED_USER=
NAVIGATOR_DRIVE_NEON_LAW_SERVICE_ACCOUNT_JSON=
# NAVIGATOR_PROJECTS_DRIVE_MOUNT=/Volumes/Projects

# ---------------------------------------------------------------------
# Public assets bucket — responsive photography + blank government forms
# ---------------------------------------------------------------------

# The public bucket that serves the marketing photography and holds the
# blank government forms, distinct from the documents bucket
# (NAVIGATOR_DOCUMENTS_BUCKET) above. `cli assets upload` pushes the
# built variant tree here (key `img/<slug>/...`) with a bounded
# Cache-Control; `navigator forms sync` vendors the sha-pinned blanks
# (key `forms/...`), which `web` pulls back at fill/download time
# (`cloud::assets_from_env`, falling back to NAVIGATOR_STORAGE_BUCKET
# for the single-bucket KIND/dev topology). Production grants
# `allUsers:objectViewer` on this bucket ONLY. By convention
# `<project>-assets`. No `gs://` prefix.
# NAVIGATOR_ASSETS_BUCKET=YOUR_PROJECT_ID-assets

# Base URL every photo `<picture>`/preload path resolves against (the
# `views::assets::asset_url` seam). Unset, it defaults to `/public` so
# KIND / `cargo test` / OSS forks serve the crate-bundled variants with
# zero config. Point it at the public assets bucket in production; when
# set to an absolute origin, `web` adds that origin to the CSP `img-src`
# automatically so the browser does not block CDN photos. Vendored
# JS/CSS stays same-origin on `/public` regardless.
# NAVIGATOR_ASSET_BASE_URL=https://storage.googleapis.com/YOUR_PROJECT_ID-assets

# ---------------------------------------------------------------------
# HTTP server — `web` binary
# ---------------------------------------------------------------------

# TCP port `web` binds to. Default: 3001.
PORT=3001

# Canonical hostname. Used by the redirect path and by absolute URL
# generation in emails. No protocol, no path — e.g. `example.com`.
CANONICAL_HOST=

# Base URL the app uses for outbound links (verification emails,
# webhook callbacks, etc.). Include scheme. Example:
# `https://app.example.com`.
# `navigator ops gcp setup` also uses this exact HTTPS origin when it
# reconciles the public assets bucket's font CORS rule.
NAV_BASE_URL=

# Chatwoot inbox for the support-chat widget on the firm's public pages. Unset
# or empty means no widget, which is the right answer for local development and
# for any deployment serving a synthetic portfolio: nothing should open a
# conversation against a live inbox from a page whose matters are invented.
#
# Not a secret. A Chatwoot website token is a public identifier that ships in
# the HTML every visitor receives, like `OAUTH_CLIENT_ID`.
NAVIGATOR_CHATWOOT_WEBSITE_TOKEN=

# The Chatwoot installation serving that widget. Unset means Chatwoot Cloud
# (`https://app.chatwoot.com`); set it to a self-hosted origin to point
# somewhere else. Include the scheme — the value also becomes the CSP source
# the page admits, so a relative or schemeless value disables the widget rather
# than silently falling back to Cloud.
NAVIGATOR_CHATWOOT_BASE_URL=

# Custom (white-label) branding opt-in. Unset → the built-in Neon Law
# identity, which is the default everywhere (web, workflows, `ops ship`). Set
# it to a brand-bundle directory to ship under your own identity; the bundle
# must load and validate or the process fails closed — a deploy that means to
# rebrand can never silently fall back to Neon Law. Kubernetes mounts the
# bundle read-only at `/etc/navigator/brand`, so a custom deploy points this
# there. Build it with `navigator ops rebrand build`.
# NAVIGATOR_CUSTOM_BRANDING=./.devx/brand-bundle

# ---------------------------------------------------------------------
# OIDC / Browser-side auth — Rauthy (KIND), Google, Auth0, Okta, …
# ---------------------------------------------------------------------
#
# Authentication is OIDC-spec-compliant: the workspace fetches the
# issuer's `.well-known/openid-configuration` and reads the
# authorization / token / jwks endpoints from there. Swapping IdPs is
# four env vars, no code change.
#
# Recipe — pick ONE block and uncomment the four lines.
#
# (1) Rauthy in KIND (the local-dev default; `navigator dev up` writes these
#     into `.devx/env` automatically — only override here if you need
#     a different issuer/client).
#   OAUTH_ISSUER_URL=http://localhost:30080/auth/v1/
#   OAUTH_CLIENT_ID=navigator-web
#   OAUTH_CLIENT_SECRET=navigatorwebsecretnavigatorwebsecretnavigatorwebsecretnavigatorw
#   OAUTH_REDIRECT_URI=http://localhost:3001/auth/callback
#
# (2) Google Identity (Cloud Identity / Workspace).
#   OAUTH_ISSUER_URL=https://accounts.google.com
#   OAUTH_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
#   OAUTH_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
#   OAUTH_REDIRECT_URI=https://app.example.com/auth/callback
#
# (3) Auth0.
#   OAUTH_ISSUER_URL=https://YOUR_TENANT.us.auth0.com/
#   OAUTH_CLIENT_ID=YOUR_AUTH0_CLIENT_ID
#   OAUTH_CLIENT_SECRET=YOUR_AUTH0_CLIENT_SECRET
#   OAUTH_REDIRECT_URI=https://app.example.com/auth/callback
#
# (4) Okta.
#   OAUTH_ISSUER_URL=https://YOUR_DOMAIN.okta.com/oauth2/default
#   OAUTH_CLIENT_ID=YOUR_OKTA_CLIENT_ID
#   OAUTH_CLIENT_SECRET=YOUR_OKTA_CLIENT_SECRET
#   OAUTH_REDIRECT_URI=https://app.example.com/auth/callback

# Issuer URL — the `iss` claim on tokens. See the recipe above.
OAUTH_ISSUER_URL=

# OAuth 2.0 client ID issued by the IdP for THIS deployment.
OAUTH_CLIENT_ID=

# OAuth 2.0 client secret. (secret)
OAUTH_CLIENT_SECRET=

# Where the IdP redirects after authentication. Must match a URI
# registered with the OAuth client. Example:
# `https://app.example.com/auth/callback`. Shared by every configured
# provider, including Microsoft below — the callback tells them apart from
# the signed pre-auth cookie, not from the path.
OAUTH_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Sign in with Microsoft — a SECOND provider, alongside the slot above
# ---------------------------------------------------------------------------
# Set `OAUTH_MICROSOFT_CLIENT_ID` and `/auth/login` grows a second button
# instead of redirecting straight to the primary IdP. Leave it unset and
# nothing changes: same page, same redirect, same session cookie.
#
# The provider slot above is NOT replaced. Google keeps issuing its own
# `sub`, so no existing `persons.oidc_subject` is invalidated and no backfill
# is needed. This is the difference between adding a door and moving the
# building.
#
# Registering the Entra application is an admin action in an Azure tenant, and
# it is not something the deployment can do for you. The checklist is in
# `docs/oidc.md`.

# Application (client) ID from the Entra app registration. Unset ⇒ the
# Microsoft door is off.
OAUTH_MICROSOFT_CLIENT_ID=

# Client secret from the same registration. Entra caps secret lifetime at 24
# months and recommends under 12; a certificate avoids the rotation entirely
# but is not wired here yet. (secret)
OAUTH_MICROSOFT_CLIENT_SECRET=

# REQUIRED once the client id is set: comma-separated Entra tenant ids
# (directory GUIDs) permitted to sign in. Boot fails without it, deliberately.
#
# This is the Microsoft counterpart of `GOOGLE_OAUTH_REQUIRED_HD`, and it is
# not optional for the same reason a domain gate is not decorative. Entra
# populates the `email` claim from a directory's `mail` attribute, which
# nobody verifies — Microsoft's own claims reference says the value "isn't
# guaranteed to be correct". Anyone can create a free Entra tenant, so with an
# open tenant list a stranger could assert a seeded person's address and
# inherit that person's role and matters. The allowlist confines sign-in to
# directories an operator named; the user principal name, which Entra can only
# issue on a domain the tenant has verified, does the rest.
#
# One line per onboarded client organisation. Example:
#   OAUTH_MICROSOFT_ALLOWED_TENANTS=11111111-2222-3333-4444-555555555555
OAUTH_MICROSOFT_ALLOWED_TENANTS=

# Optional authority override. Default:
# `https://login.microsoftonline.com/organizations/v2.0` — work or school
# accounts from any Entra tenant, personal Microsoft accounts excluded.
#
# Point it at `https://login.microsoftonline.com/<tenant-guid>/v2.0` for a
# single-tenant registration. That authority publishes a concrete issuer
# rather than the `{tenantid}` template, so the ordinary byte-compare applies
# and nothing else needs changing.
# OAUTH_MICROSOFT_ISSUER_URL=

# Optional JWKS endpoint. If unset, the workspace fetches the issuer's
# OIDC discovery document and reads `jwks_uri` from there.
# OIDC_JWKS_URL=

# Symmetric HS256 signing secret. Used only by mocked OIDC tests;
# Rauthy and production Google identity use RS256 via JWKS. (secret)
# OIDC_HS256_SECRET=

# Set to `true` or `1` to bypass OIDC entirely (host-side dev only).
# Refused at startup by `enforce_deployment_invariants` — a deploy may never
# turn the bearer-token verifier into an open pass-through.
# OIDC_DISABLED=false

# Expected `aud` and `iss` on bearer JWTs (the `/mcp` + `/api` path).
# When set, the bearer verifier pins them so a token minted for a
# different client of the same IdP is rejected (token-confusion defense).
# Leave unset only for dev; production should pin both. `OIDC_AUDIENCE`
# is the OAuth client_id; `OIDC_ISSUER` is the IdP issuer URL.
# OIDC_AUDIENCE=
# OIDC_ISSUER=

# CSRF + session cookie signing key. Must be at least 32 bytes of
# entropy; rotating it invalidates every active session. (secret)
SESSION_SECRET=

# System bootstrap Owner. The OAuth callback JIT-creates exactly this
# one identity as `owner` on first login — the carve-out so a fresh
# deploy is never locked out. Every other unseeded identity is rejected
# (sign-up is operator-mediated). Leave empty to disable the carve-out.
# NAVIGATOR_BOOTSTRAP_OWNER_EMAIL=owner@example.com

# A legal Entity that anchors the firm. It is never deletable or renameable by
# lawyer or admin through Navigator. The canonical seed's own Shook Law PLLC row
# carries that protection in every deployment because the seed re-creates it by
# exact name on every boot; a white-label operator names its own legal entity
# here to protect that row too, once it exists.
# NAVIGATOR_BOOTSTRAP_COMPANY=Shook Law PLLC

# Global self-signup toggle, OFF by default. When off (unset/blank/false), an
# IdP-authenticated email with no pre-seeded `persons` row is rejected (403) —
# onboarding stays operator-mediated. When on, the first login for an unknown
# verified email JIT-creates a `client` with an EMPTY portfolio (no
# `person_project_roles`) until an admin assigns participation. The bootstrap
# admin above is unaffected either way. A training deployment turns this on when
# trainings open. Affirmative values: 1, true, yes, on. See #738.
# NAVIGATOR_SELF_SIGNUP_ENABLED=false

# Private mode, OFF by default. When on, the Kubernetes setup puts a Pingora
# gateway in front of `web` and every request must carry HTTP basic
# auth (`go` / `bears`) — `navigator dev up` applies the `kind-private`
# overlay and `navigator ops ship` appends the `private-mode` component to
# the GKE tree. It keeps a staged deployment from being crawled or wandered
# into; it is NOT an authorization boundary (that is still `persons.role` +
# embedded Rego), and webhook callers get 401 while it is on. Affirmative values: 1,
# true, yes, on. See docs/env-driven-devx.md.
# NAVIGATOR_PRIVATE_MODE=false

# Email/password front door via GCP Identity Platform (opt-in). When set,
# `/auth/login` renders an email/password form alongside the OIDC button,
# and `POST /auth/password` validates the password against Identity
# Platform's `accounts:signInWithPassword` over TLS. Neon Law Navigator NEVER
# stores or hashes a password — Google owns the credential, the reset
# flow, and lockout. This is the project's Identity Platform *browser*
# API key (not an admin credential). Leave empty to keep `/auth/login` a
# pure OIDC redirect. The resolved session is the same signed
# `SessionData` cookie either way. (secret)
# NAVIGATOR_IDENTITY_PLATFORM_API_KEY=
# Override the Identity Toolkit REST base (test seam). Default:
# `https://identitytoolkit.googleapis.com`.
# NAVIGATOR_IDENTITY_PLATFORM_ENDPOINT=

# Self-service password reset + email confirmation (for email/password,
# i.e. non-Google, users) reach Identity Platform's ADMIN surface to set a
# new password or mark an email verified — operations the public browser
# API key above can't perform. The admin call authenticates with a
# service-account bearer token minted from the GCE metadata server (no GCP
# SDK in `web`); on the reference deploy `web` runs as a Workload-Identity
# GSA granted `roles/identitytoolkit.admin`. These flows mount only when
# the password door above is on AND NAVIGATOR_GCP_PROJECT_ID (below) is
# set; the reset email itself ships through SendGrid like every other
# transactional email. Override the metadata server only in tests:
# NAVIGATOR_GCP_METADATA_ENDPOINT=http://metadata.google.internal

# ---------------------------------------------------------------------
# Google OAuth access-token validation — the `/mcp` and A2A surfaces
# ---------------------------------------------------------------------

# Comma-separated list of OAuth client IDs allowed to call `/mcp` and
# `/api/aida/rpc`. Used to accept opaque `ya29.*` access tokens from
# Gemini Enterprise / Claude.ai. Required on every deployed environment:
# left empty, `require_google_oauth` does not call tokeninfo at all — it
# passes through, no `Principal` is injected, and AIDA's per-Project
# scope checks stop running. Empty is the KIND/local-dev shape only,
# where `require_auth` handles the Bearer-JWT path instead.
GOOGLE_OAUTH_CLIENT_IDS=

# Required workspace domain (the `hd` claim) on incoming Google OAuth
# tokens. Reject tokens that don't carry this `hd`. Example:
# `example.com`. Leave empty to skip the hd check.
GOOGLE_OAUTH_REQUIRED_HD=

# Override Google's tokeninfo endpoint (test seam). Default:
# `https://oauth2.googleapis.com/tokeninfo`.
# GOOGLE_TOKENINFO_URL=

# Override the GCE metadata server URL (test seam). Default:
# `http://metadata.google.internal`.
# GOOGLE_METADATA_URL=

# Per-IP request budget per minute on the abuse-sensitive endpoints
# (/auth/*, /mcp, /api/aida/rpc). Unset → defaults to 60/min. Set to `0`
# to disable (e.g. when the edge WAF/Cloud Armor already rate-limits).
# NAVIGATOR_RATE_LIMIT_PER_MIN=60

# ---------------------------------------------------------------------
# Restate — durable workflow runtime
# ---------------------------------------------------------------------

# Restate broker URL. KIND: in-cluster Restate Operator service.
# Production: Restate Cloud ingress URL.
RESTATE_BROKER_URL=

# REST endpoint used by external workflow submitters. The DevX API receiver
# posts its typed commands here without holding a Restate bearer token.
# RESTATE_INGRESS_URL=http://restate.navigator.svc.cluster.local:8080

# Restate Cloud auth token (secret). Not needed for the in-cluster
# operator in KIND.
# RESTATE_AUTH_TOKEN=

# Restate service name registered with the broker. Default:
# `workflows`.
# RESTATE_SERVICE=workflows

# Restate ingress used by the scheduled trigger binaries. In production
# CronJobs this normally matches the deployed broker ingress.
# RESTATE_INGRESS_URL=

# TCP address the worker binary binds to so Restate can dial it.
# Default: `0.0.0.0:9080`.
# WORKFLOWS_SERVICE_LISTEN=0.0.0.0:9080

# TCP address the GitHub webhook receiver's Axum listener binds to, separate
# from the Restate endpoint above. Only the automation-home deployment binds it;
# Envoy routes /webhooks/github/* to it. Default: `0.0.0.0:9082`.
# WORKFLOWS_WEBHOOK_LISTEN=0.0.0.0:9082

# URL the CLI / web crate uses to reach the Restate worker for
# admin operations (deployment registration, invocation listing).
# NAVIGATOR_WORKFLOWS_URL=https://workflows.example.com

# Restate Cloud admin API endpoint + token. When BOTH are set,
# `power-push` step 7d (and `navigator ops restate register`) re-registers the
# worker via the admin REST API directly, instead of the `restate` CLI —
# headless, needs no `restate cloud env configure` (which requires a TTY),
# and works with a non-expiring admin-scoped API key. Find the admin URL in
# the Restate Cloud console (DescribeEnvironment `adminBaseUrl`, port :9070);
# RESTATE_ADMIN_TOKEN must be an admin-scoped API key, NOT the ingress key.
# Unset → fall back to the `restate` CLI (KIND dev loop / fresh SSO token).
# RESTATE_ADMIN_URL=https://your-env.env.us.restate.cloud:9070
# RESTATE_ADMIN_TOKEN=

# OpenTelemetry — one seam for every binary (`telemetry::init`). A complete
# contract exports traces, metrics, and logs directly to OpenObserve over
# OTLP/gRPC; an unset endpoint keeps human-readable stdout only, while a
# partial contract fails closed to stdout. See docs/observability.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.openobserve.ai:5081
# Browser-facing OpenObserve URL printed by local tooling and operator docs.
# NAVIGATOR_OPENOBSERVE_URL=https://openobserve.example.com
# Basic-auth credentials and routing attached to every OTLP signal. (secret)
# NAVIGATOR_OPENOBSERVE_USERNAME=telemetry@example.com
# NAVIGATOR_OPENOBSERVE_PASSWORD=
# NAVIGATOR_OPENOBSERVE_ORGANIZATION=default
# NAVIGATOR_OPENOBSERVE_STREAM=default
# OTEL_SERVICE_NAME overrides the per-binary default (`neon-server`,
# `workflows-service`, or the selected trigger service).
# OTEL_SERVICE_NAME=
# Standard tracing filter. Default is binary-specific; `info` is the normal
# deployed value.
# RUST_LOG=info

# Release identity is normally baked into published images, not supplied by
# an operator. Local source builds honestly report `unknown` when unset.
# NAVIGATOR_RELEASE_TAG=YY.M.D
# NAVIGATOR_GIT_SHA=<full-commit-sha>
# NAVIGATOR_BUILD_TIME=<RFC3339-timestamp>

# ---------------------------------------------------------------------
# GitHub webhooks — issue-to-PR loop, folded into navigator-server + workflows-service
# ---------------------------------------------------------------------
#
# The receiver is a route in `navigator-server` (POST /hooks/github/{secret}); the durable
# notice services (DevxIssueTriage, devx-pr) bind into `workflows-service`. No
# separate deployment, host, or binary. They run only when
# NAVIGATOR_GCP_PROJECT_ID is `neon-law-stg`: that code-enforced singleton
# owns the one GitHub App webhook URL and global automation budget. Other
# deployments ignore the webhook configuration even if their shared Secret is
# accidentally copied there.

# The receiver verifies the path token and GitHub's HMAC over the raw body with
# this sole secret. Set the SAME value as the GitHub App's webhook secret and in
# its payload URL path. Keep it in the deployment's secrets.enc.yaml.
# NAVIGATOR_GITHUB_WEBHOOK_SECRET=                 # (secret)

# The public open-source code repository, always watched. Every private repo in
# NAVIGATOR_GITHUB_ORG (each backing a Project) is also watched by owner; a
# delivery for any other repository is rejected.
# NAVIGATOR_GITHUB_CANONICAL_REPOSITORY=neon-law-source-code/navigator

# Login of the coordinating GitHub App (`<app-slug>[bot]`). Self-events are
# ignored except its `triaged` label, which advances triage to implementation.
# NAVIGATOR_GITHUB_APP_LOGIN=neon-law-nightwatch[bot]

# Spending caps for the singleton automation home (`neon-law-stg`) only.
# Every value is required there and must be a positive integer. The worker
# serializes all reservations through `devx-guardrails/global`: concurrent work
# waits at the first cap, while a daily token overrun pauses new work until UTC
# midnight. These are counts only; issue bodies, prompts, and diffs never enter
# the guardrail state.
# NAVIGATOR_GITHUB_MAX_CONCURRENT=2
# NAVIGATOR_GITHUB_MAX_REVISE_ROUNDS=8
# NAVIGATOR_GITHUB_MAX_DAILY_TOKENS=100000

# The receiver submits through RESTATE_INGRESS_URL + RESTATE_AUTH_TOKEN (see the
# Restate section); the folded-in worker reads SLACK_WEBHOOK_URL from
# workflows-service. Both arrive via the shared Secret.

# Slack incoming-webhook URL for INTERNAL ops notifications. When set, the
# worker posts every internal/ops notice (Heartbeat, Archives, BillingCanary,
# BillingDigest) to this webhook, where engineers watch — these
# notices go to Slack only (the duplicate ops email was dropped once Slack
# proved reliable). Unset/empty → captured in-memory (KIND, tests), nothing
# posted. NEVER carries client content: client-facing email (retainers,
# invoices) is never posted to chat. The webhook URL itself pins the
# destination channel; the reference deployment pins it to #navigator.
# (secret — value in the deployment's secrets.enc.yaml)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Slack mention prepended to the ops messages that should reach a human: the
# `deploy.yml` "ready to deploy" hand-off and the deploy/cleanup *failure*
# alerts tag this so the on-call (Nick) is paged. A full Slack mention token —
# a user `<@U…>` or a group `<!subteam^…>`. Leave empty to post those messages
# with no @-mention (a fork with no designated on-call). A GitHub Actions
# secret, `secrets.SLACK_OPS_MENTION`, alongside the workflow Slack
# webhooks; the workflows read it, the running services do not. (config —
# workflow-only)
# SLACK_OPS_MENTION=<@U0000000000>

# ---------------------------------------------------------------------
# Email — real SendGrid by default; capturing only in the CI harness
# ---------------------------------------------------------------------

# `sendgrid` for the bare-SendGrid backend; anything else routes to
# the in-memory `CapturingEmail` so nothing leaves the binary.
# Normal staging and production refuse anything but `sendgrid`.
NAVIGATOR_EMAIL_BACKEND=sendgrid

# SendGrid API key. (secret)
SENDGRID_API_KEY=

# From: address for outbound mail. Example: `noreply@example.com`.
SENDGRID_FROM_EMAIL=

# Optional Mail API base URL. Production accepts only the official
# `api.sendgrid.com` / `api.eu.sendgrid.com` hosts. The KIND CI harness may
# set this to its secret-gated synthetic `/v3/mail/send` sink.
SENDGRID_BASE_URL=

# Required only when `SENDGRID_BASE_URL` is overridden under
# `NAVIGATOR_CI_HARNESS=1`; never use a harness sink in production. (secret)
NAVIGATOR_SENDGRID_HARNESS_SECRET=

# Shared secret embedded in the SendGrid Inbound Parse webhook URL
# (`/webhook/sendgrid/inbound/<secret>`). Without it, anyone on the
# internet can forge inbound mail into the mailroom. (secret)
SENDGRID_INBOUND_SECRET=

# Cluster-private `clamd` TCP address used to scan every inbound attachment
# before Navigator archives, forwards, or files any message side effect.
# Required in every deployed profile; `navigator dev up` writes the host
# port-forward automatically. The scanner fails closed.
NAVIGATOR_CLAMD_ADDR=clamav.navigator.svc.cluster.local:3310

# Shared secret embedded in the SendGrid Event Webhook URL
# (`/api/email-events/<secret>`), which lands delivery events as
# Parquet on GCS for BigQuery. Without it, anyone could POST forged
# delivery events into the lake. See docs/email-events-pipeline.md.
# (secret)
SENDGRID_EVENTS_SECRET=

# SendGrid "Signed Event Webhook" verification key — the ECDSA/P-256
# public key SendGrid issues, base64-encoded DER SubjectPublicKeyInfo
# (the value the SendGrid Mail Settings → Signed Event Webhook screen
# shows). The Event Webhook verifies each delivery POST's signature over
# `timestamp || body` against this key, so a leaked endpoint URL alone
# cannot forge events. Required in production. (public key, not a secret)
SENDGRID_EVENTS_PUBLIC_KEY=

# Email-threading ("headless Front"). Both must be set to turn inbound
# support email into threaded conversations; if either is empty the
# webhook only archives the raw message. NAVIGATOR_PARSE_HOST is the
# subdomain whose MX points at SendGrid Inbound Parse — it is the host of
# every Reply-To token address (`c<token>@<parse_host>`).
# NAVIGATOR_LAWYER_NOTIFY_EMAIL is the cockpit inbox that gets notified of
# new support mail; a reply from that mailbox is relayed back to the
# external party. Example: `parse.example.com` and `you+support@example.com`.
NAVIGATOR_PARSE_HOST=
NAVIGATOR_LAWYER_NOTIFY_EMAIL=

# Optional: firm domain a lawyer reply's DKIM verdict must pass for before
# the reply is trusted to relay to the client or fire a workflow command
# (`@approve` etc.). When set (e.g. `example.com`), a lawyer reply whose
# SendGrid `dkim` verdict is not `pass` for this domain is journaled but
# neither relayed nor executed — closing the forged-`From` + leaked-token
# hole on the privileged command channel. Leave empty to gate the channel
# on lawyer-sender + unguessable token alone (the pre-DKIM posture).
NAVIGATOR_DKIM_REQUIRE_DOMAIN=

# ---------------------------------------------------------------------
# E-signature — DocuSign
# ---------------------------------------------------------------------
# When DOCUSIGN_BASE_URL + DOCUSIGN_ACCOUNT_ID are set together with
# EITHER a JWT-grant key set (DOCUSIGN_INTEGRATION_KEY + DOCUSIGN_USER_ID
# + DOCUSIGN_PRIVATE_KEY) OR a static DOCUSIGN_ACCESS_TOKEN, `web` uses
# the real `DocuSignSignatureProvider` to send the rendered retainer for
# signature; the explicit CI harness may fall back to the in-process stub.
# JWT grant is preferred — the provider mints and refreshes
# short-lived tokens itself, so there is no 8-hour token to rotate. OSS
# forks plug in their own DocuSign account or swap the
# `SignatureProvider` impl entirely.

# DocuSign follows the third-party dev/prod convention (see "Conventions"
# at the top of this file): a SANDBOX (demo) app for local dev — pointing
# at demo.docusign.net / account-d.docusign.com, so test envelopes carry
# NO legal weight and never touch the production account — and a separate
# live app for production. Sandbox credentials go in `.env`, production
# credentials in `.env.production`; both use the same DOCUSIGN_* names
# below. Normal staging and production require a complete configuration.
# Full setup runbook (where each ID lives in the console, consent, the
# live test): docs/docusign-esignature.md.

# eSignature REST base URL. Sandbox: `https://demo.docusign.net/restapi`;
# production is the account's assigned base URI.
DOCUSIGN_BASE_URL=

# DocuSign API account GUID.
DOCUSIGN_ACCOUNT_ID=

# --- Auth: JWT grant (preferred; self-refreshing) ---
# The app's Integration Key (OAuth client id, a GUID) from the DocuSign
# Apps & Keys page. This is the JWT `iss`. NOTE: it is NOT the OAuth
# "secret key" — supplying the secret here makes a token mint fail with
# `issuer_not_found`. JWT grant does not use the OAuth secret at all.
DOCUSIGN_INTEGRATION_KEY=
# The impersonated API user's GUID (the "API Username" / User ID on the
# same Apps & Keys page) — used as the JWT `sub`.
DOCUSIGN_USER_ID=
# RSA private-key PEM whose public half is uploaded to the integration
# key; needs one-time admin consent for `signature impersonation`.
# Multi-line — quote the value. (secret)
DOCUSIGN_PRIVATE_KEY=
# OAuth host. Optional — defaults to the demo host
# `https://account-d.docusign.com`; production is
# `https://account.docusign.com`.
DOCUSIGN_OAUTH_BASE=

# --- Auth: static token (fallback for a quick local/demo smoke test) ---
# OAuth bearer access token for the eSignature API; DocuSign expires it
# in ~8h. Ignored when the JWT-grant vars above are set. (secret)
DOCUSIGN_ACCESS_TOKEN=

# Envelope recipient (the signer). Optional — defaults to the firm's
# support inbox / "Neon Law".
DOCUSIGN_SIGNER_EMAIL=
DOCUSIGN_SIGNER_NAME=

# HMAC-SHA256 key DocuSign Connect signs each completion callback with.
# The `/webhook/esignature/<secret>` endpoint verifies the
# `X-DocuSign-Signature-1` header over the raw body before advancing a
# retainer to END — without it, anyone could forge a "completed"
# callback (the firm asserting a client signed when they did not).
# Required in production. (secret)
DOCUSIGN_HMAC_KEY=

# Optional coarse path token in the webhook URL
# (`/webhook/esignature/<secret>`); defense-in-depth on top of the HMAC.
DOCUSIGN_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Accounting / billing — Xero
# ---------------------------------------------------------------------
# When XERO_TENANT_ID is set together with EITHER a client-credentials
# pair (XERO_CLIENT_ID + XERO_CLIENT_SECRET) OR a static XERO_ACCESS_TOKEN,
# `web` uses the real `XeroBillingProvider` to raise the matter's flat-fee
# invoice; otherwise it falls back to the in-process stub (KIND / local
# dev). Client-credentials is preferred — the provider mints and refreshes
# short-lived tokens itself, so there is no 30-minute token to rotate. OSS
# forks plug in their own Xero custom connection or swap the
# `BillingProvider` impl entirely.

# Xero follows the third-party dev/prod convention (see "Conventions" at
# the top of this file and docs/third-party-integrations.md): a SANDBOX
# custom connection bound to the free Xero DEMO COMPANY for local dev — so
# test invoices carry NO ledger weight and never touch the live
# organisation — and a separate live custom connection for production.
# Sandbox credentials go in `.env`, production credentials in
# `.env.production`; both use the same XERO_* names below. Unconfigured →
# the in-process stub, which sends nothing real. NOTE: a custom connection
# is a paid, single-organisation app ($5/mo USD each); the demo company is
# the one free exception and is the right target for dev + CI.

# The connected organisation's id, sent as the `Xero-Tenant-Id` header on
# every Accounting API call. A custom connection binds to one org, so this
# is fixed per environment. Required to activate the real provider.
XERO_TENANT_ID=

# Xero Accounting API base. Optional — defaults to
# `https://api.xero.com/api.xro/2.0`.
XERO_BASE_URL=

# --- Auth: client-credentials (preferred; self-refreshing) ---
# The custom connection's Client ID and Client Secret from the Xero
# developer portal. The secret is shown once at creation. (secret)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Token endpoint. Optional — defaults to
# `https://identity.xero.com/connect/token`.
XERO_TOKEN_URL=
# Space-separated scopes to request; must also be granted on the custom
# connection. A custom connection grants granular scopes — the legacy
# parent `accounting.transactions` is not offered and minting fails with
# `invalid_scope` if requested. Optional — defaults to
# `accounting.contacts accounting.invoices`.
XERO_SCOPE=

# --- Auth: static token (fallback for a quick local/demo smoke test) ---
# OAuth bearer access token for the Accounting API; Xero expires it in
# ~30m. Ignored when the client-credentials vars above are set. (secret)
XERO_ACCESS_TOKEN=

# --- Live sandbox test only (CI alias) ---
# The gated live test (`web/tests/xero_sandbox.rs`, mint against the real
# demo-company connection) reads these first, then FALLS BACK to the
# canonical XERO_CLIENT_ID/XERO_CLIENT_SECRET above. So locally you only
# need the canonical vars (one demo connection drives both the dev app and
# the test); these SANDBOX names exist for CI (GitHub Actions secrets),
# where labelling the creds "sandbox" keeps demo isolated from any live
# XERO_*. The test self-skips when neither is set, so CI stays green on
# forks. Same shape as the runtime client-credentials vars. (secret)
XERO_SANDBOX_CLIENT_ID=
XERO_SANDBOX_CLIENT_SECRET=

# ---------------------------------------------------------------------
# GitHub — the code repository and the DevX automation
# ---------------------------------------------------------------------
# Projects have no repository: Navigator provisions none and reconciles
# none. What is left here serves `neon-law-source-code/navigator` itself —
# the webhook receiver, the DevX Restate services, and the lawyer-only
# repository pointer.

# Optional per-Project repo audit layer, retiring with the matter-document
# lane. When NAVIGATOR_GIT_REPO_ROOT is set, `web` also commits each filed
# document into a local bare repo as a `git log` audit projection; unset,
# that layer is skipped and documents still persist to object storage.
# NAVIGATOR_GIT_REPO_ROOT=/var/lib/navigator/repos

# The forge host this deployment's repositories live on. Half of one
# coordinate, paired with NAVIGATOR_GITHUB_ORG below: that pair is where this
# deployment's Project repositories are created, and it is the boundary
# `navigator ops github setup` refuses a governance write outside. A remote in
# neither admissible organization is refused before a token is read.
#
# Nothing composes this into a clone URL for a Project that already exists. A
# Project's source repository is a whole URL stored on the matter
# (`project.repository_url`) and may live on any forge, in any organization.
#
# Defaults to `github.com`, which is where Navigator itself and every
# deployment the Firm operates live — so a fresh clone needs it not at all. Set
# it only when self-hosting on another forge. A blank value is NOT the default:
# a configuration templated and never filled in fails closed naming this key.
# NAVIGATOR_GIT_HOST=github.com

# GitHub App. Server-side access is a GitHub App installed on the org
# (contents + issues): `web` mints a short-lived RS256 App JWT over the
# private key, exchanges it for an hour-long installation token, and calls
# the REST API with that — the same auth pattern as the automerge App
# (docs/gitops.md). The staging CI harness may skip them (an integration
# credential set).

# The one organization this deployment's own automation occupies. Each
# deployment has its own (docs/provider-environment-parity.md). Required once a
# deployment is named, with no default.
#
# Not a Project's source coordinate: a Project records its repository as a whole
# URL on the matter, so a client's source may sit in any organization on any
# forge.
NAVIGATOR_GITHUB_ORG=
# The App's numeric App ID (the JWT `iss`), from the App's settings page.
NAVIGATOR_GITHUB_APP_ID=
# The App's RSA private-key PEM (the JWT signing key). Multi-line — quote
# the value. (secret)
NAVIGATOR_GITHUB_APP_PRIVATE_KEY=
# Optional: pin the org installation id. Discovered from
# `GET /orgs/<org>/installation` when unset.
# NAVIGATOR_GITHUB_INSTALLATION_ID=
# Optional: override the REST API base (the sandbox test / a GitHub
# Enterprise host). Default: `https://api.github.com`.
#
# Naming a GitHub Enterprise host here is deliberate, not left over from
# Navigator's own move to github.com: this is the knob a self-hoster sets to
# point their instance at their own tenant.
# NAVIGATOR_GITHUB_API_BASE=https://api.github.com

# `navigator ops github setup` authenticates its repository-settings
# reconciliation with this fine-grained token. Grant Administration: Read and
# write, Contents: Read, and Issues: Read and write on the target repository.
# The command discovers that repository from GITHUB_REPOSITORY (CI) or the
# local `origin` remote. (secret)
# GITHUB_TOKEN=

# ---------------------------------------------------------------------
# Content directories — markdown that `web` serves
# ---------------------------------------------------------------------

# Override these only if you keep content outside the source tree.
# Defaults point at the in-repo `web/content/` subdirs.
# NAVIGATOR_PUBLIC_DIR=web/public
# NAVIGATOR_BLOG_DIR=web/content/blog
# NAVIGATOR_WORKSHOPS_DIR=web/content/workshops

# ---------------------------------------------------------------------
# A2A natural-language router — Vertex AI Gemini Flash
# ---------------------------------------------------------------------

# GCP project for the Vertex AI router. Leave unset to use the
# `NullRouter` (returns "I don't route requests" — fine for KIND
# and OSS forks that don't ship LLM routing).
# NAVIGATOR_GCP_PROJECT_ID=YOUR_PROJECT_ID
# Immutable public-site image for this deployment. It must match the domain's
# brand exactly: `neon-server`.
# NAVIGATOR_WEB_IMAGE=neon-server

# Vertex AI region. Must be a region where the chosen model is
# available. Example: `us-west4`.
# NAVIGATOR_GCP_LOCATION=YOUR_REGION

# Model name. Example: `gemini-2.5-flash`.
# NAVIGATOR_ROUTER_MODEL=gemini-2.5-flash

# Contract-review model. Uses the same GCP project and location as the
# A2A router. Unset → the deterministic StubContractReviewer.
# NAVIGATOR_CONTRACT_REVIEW_MODEL=gemini-2.5-flash

# Override the GCE metadata token endpoint used by both Vertex clients.
# Test seam; normal GKE uses the metadata-server default.
# GOOGLE_METADATA_URL=http://metadata.google.internal

# ---------------------------------------------------------------------
# On-chain attestation — Neon Law Node (Solana)
# ---------------------------------------------------------------------
#
# Selects the backend for the `onchain__record_attestation` workflow
# step. `null` (or unset) uses the `NullAttestor`: the step still writes
# the durable local `attestations` row, but records NO transaction — the
# row stays `pending`, so no matter ever claims an on-chain record that
# does not exist. This is the default for KIND, tests, and any deploy
# that has not stood up a wallet. `solana` is reserved for the
# not-yet-shipped `SolanaAttestor` and currently errors at startup by
# design, so a deployer cannot silently believe attestations are going
# on-chain when they are not.
NAVIGATOR_ONCHAIN_BACKEND=null

# Solana RPC endpoint the `SolanaAttestor` will dial (e.g. a devnet or
# mainnet-beta URL). Unused while the backend is `null`.
# SOLANA_RPC_URL=

# Address of the deployed on-chain attestation program (the Anchor
# program that owns the per-notation attestation PDA). Unused while the
# backend is `null`.
# SOLANA_PROGRAM_ID=

# Reference to the firm signer keypair that pays fees and signs the
# attestation transaction. This is a custody-sensitive secret: in prod it
# resolves from Secret Manager / KMS, never a path on disk. Unused while
# the backend is `null`. (secret)
# SOLANA_SIGNER_SECRET=

# ---------------------------------------------------------------------
# `navigator` CLI KIND / local dev loop
# ---------------------------------------------------------------------
#
# Every knob the `navigator dev up` / `dev deploy` / `dev down` KIND loop reads. All are
# optional: unset (or empty) each falls back to the default shown, so an
# empty `.env` reproduces the stock `cargo run -p cli -- dev up` behavior.
# A fork plugs its own cluster name, namespace, overlays, and host ports
# in here and runs the same `navigator` CLI with no Rust edits.

# KIND cluster name (`kind create cluster --name`). Default: `navigator`.
# NAVIGATOR_KIND_CLUSTER=navigator

# Kubernetes namespace the `navigator` CLI applies into and port-forwards from. Same
# concept in KIND and GKE, so it has no provider prefix. Default:
# `navigator`.
# NAVIGATOR_K8S_NAMESPACE=navigator

# Kustomize overlay `navigator dev up` applies (deps only, no in-cluster `web`).
# Default: `k8s/overlays/kind-deps`.
# NAVIGATOR_KIND_DEPS_OVERLAY=k8s/overlays/kind-deps

# Kustomize overlay `navigator dev deploy` applies (full local stack incl. web).
# Default: `k8s/overlays/kind`.
# NAVIGATOR_KIND_OVERLAY=k8s/overlays/kind

# Kustomize overlay `navigator dev kustomize gke` renders for inspection.
# Default: `examples/deploy/k8s/gke`.
# NAVIGATOR_GKE_OVERLAY=examples/deploy/k8s/gke

# Host ports the locally-run `web` binary reaches in-cluster deps on.
# These are pure host-side `kubectl port-forward` choices —
# `LOCAL` is arbitrary, nothing in the cluster changes. Default ports
# avoid common host collisions (SurrealDB 18000; Restate
# ingress 9080, not the KIND-ingress 8080).
# NAVIGATOR_KIND_SURREAL_PORT=18000
# NAVIGATOR_KIND_RESTATE_INGRESS_PORT=9080
# NAVIGATOR_KIND_RESTATE_ADMIN_PORT=9070
# NAVIGATOR_KIND_WEB_PORT=3001

# Rauthy (30080) and Garage S3 (30900) reach the host through
# `k8s/kind-config.yaml` `extraPortMappings`, which bind at cluster
# create time. Overriding either makes the `navigator` CLI render a temp kind-config
# with only the matching `hostPort:` substituted; the in-cluster
# NodePort stays fixed, so the Service manifests stay in sync.
# NAVIGATOR_KIND_RAUTHY_PORT=30080
# NAVIGATOR_KIND_GARAGE_S3_PORT=30900

# OpenObserve UI and direct OTLP/gRPC host ports. Defaults: 5080 and 5081.
# NAVIGATOR_KIND_OPENOBSERVE_PORT=5080
# NAVIGATOR_KIND_OPENOBSERVE_OTLP_PORT=5081

# Optional KIND Garage credential overrides. Unset values use deterministic
# development-only defaults and feed both `.devx/env` and the cluster Secret.
# NAVIGATOR_GARAGE_ACCESS_KEY=navigator-kind
# NAVIGATOR_GARAGE_SECRET_KEY=navigator-kind-secret
# NAVIGATOR_GARAGE_ASSETS_ACCESS_KEY=navigator-assets
# NAVIGATOR_GARAGE_ASSETS_SECRET_KEY=navigator-assets-secret
# NAVIGATOR_GARAGE_APPLICATIONS_ACCESS_KEY=navigator-applications
# NAVIGATOR_GARAGE_APPLICATIONS_SECRET_KEY=navigator-applications-secret
# NAVIGATOR_GARAGE_LFS_ACCESS_KEY=navigator-lfs
# NAVIGATOR_GARAGE_LFS_SECRET_KEY=navigator-lfs-secret

# Published image tag pulled by `navigator dev deploy`. Unset selects the
# latest dated `YY.M.D` tag.
# NAVIGATOR_IMAGE_TAG=YY.M.D

# ---------------------------------------------------------------------
# `navigator ops gcp setup` — fresh-project provisioning
# ---------------------------------------------------------------------
#
# Used by `navigator ops gcp setup` and `navigator ops ship`. The defaults are
# convenient for one deployment per project. Set every name explicitly when
# multiple deployments share a project.

# GKE cluster name created by `navigator ops gcp setup`. Default:
# `navigator-prod`.
# NAVIGATOR_GKE_CLUSTER_NAME=navigator-prod

# GCP project that holds the container images — the `<project>` in
# `<region>-docker.pkg.dev/<project>/<repo>/navigator-web`. CI builds
# each image once and pushes it here, to the shared hub, while an
# environment's GKE cluster and buckets stay in its own
# NAVIGATOR_GCP_PROJECT_ID. Leave unset for a single-project deployment
# The registry namespace the container images live in — the
# `ghcr.io/<owner>` half of every image reference. CI publishes each image
# there tagged `YY.M.D` and `navigator ops ship` rolls the cluster onto a
# published tag.
#
# One variable where Artifact Registry needed three (a region, a hub
# project, and a repository name, any two of which could disagree and
# produce a valid reference to somewhere no image had been pushed). The
# images are PUBLIC, so nothing needs a reader grant and a local
# `docker pull` needs no `docker login`.
#
# Default: `ghcr.io/neon-law-source-code`. A fork overrides this one value
# and every image reference follows it.
# NAVIGATOR_IMAGE_REGISTRY=ghcr.io/neon-law-source-code

# `navigator ops ship` reconciles the GKE manifests from a tree EMBEDDED in
# the CLI, rendered with the NAVIGATOR_* values below into a throwaway temp
# dir and `kubectl apply -k`'d — no external overlay folder, runs from any
# directory. The two OAuth client IDs below are the non-secret substitutions
# the render needs (the project id and primary domain it reads from the vars
# already set above). Required at ship time; fail-fast by name if unset. See
# `docs/gke-prod.md` and `docs/cloud-operations.md`.

# Public browser-SSO OAuth client ID (the full `<id>.apps.googleusercontent.com`),
# substituted for `YOUR_OAUTH_CLIENT_ID_BROWSER` in the rendered manifests.
NAVIGATOR_OAUTH_CLIENT_ID_BROWSER=

# Public Gemini Enterprise data-store OAuth client ID (full
# `<id>.apps.googleusercontent.com`), substituted for `YOUR_OAUTH_CLIENT_ID_GEMINI`.
NAVIGATOR_OAUTH_CLIENT_ID_GEMINI=

# VPC network name. Default: `navigator-vpc`.
# NAVIGATOR_VPC_NAME=navigator-vpc

# Regional subnetwork used by GKE. Default: `navigator-subnet`.
# NAVIGATOR_SUBNETWORK_NAME=navigator-subnet

# Static external IP reserved for the global HTTPS LB. Default:
# `navigator-gateway-ip`.
# NAVIGATOR_GATEWAY_IP_NAME=navigator-gateway-ip

# Exact per-deployment bucket names. Defaults are `<project>-assets`,
# `<project>-documents`, `<project>-exports`, `<project>-logs`, and
# `<project>-applications`; shared projects must override all five. No `gs://`
# prefix.
# NAVIGATOR_ASSETS_BUCKET=navigator-assets
# NAVIGATOR_DOCUMENTS_BUCKET=navigator-documents
# NAVIGATOR_EXPORTS_BUCKET=navigator-exports
# NAVIGATOR_LOGS_BUCKET=navigator-logs
# NAVIGATOR_APPLICATIONS_BUCKET=navigator-applications

# Runtime Google service-account id created by setup and bound to the
# namespace's `navigator-web` and `workflows-service` Kubernetes service
# accounts. Default: `navigator-web`; shared projects must override it.
# NAVIGATOR_GCP_SERVICE_ACCOUNT_ID=navigator-web

# Dedicated service-account id for the Google Workspace Drive credential.
# Setup creates the identity with no runtime GCP roles. A Workspace admin still
# grants its OAuth client domain-wide delegation, and an operator stores one
# generated JSON key under the selected NAVIGATOR_DRIVE_*_SERVICE_ACCOUNT_JSON
# key in that deployment's secrets.enc.yaml. Default: `navigator-drive`.
# NAVIGATOR_DRIVE_GCP_SERVICE_ACCOUNT_ID=navigator-drive

# Kubernetes namespace rendered into every GKE resource. Default: `navigator`;
# shared projects must override it.
# NAVIGATOR_K8S_NAMESPACE=navigator

# Optional Config Sync source applied by `navigator ops gcp setup`.
# NAVIGATOR_CONFIG_SYNC_REPO=https://github.com/YOUR_ORG/YOUR_REPO
# NAVIGATOR_CONFIG_SYNC_DIR=examples/deploy/k8s/gke

# `navigator ops ship` target/context overrides. The context defaults to the
# GKE convention derived from project + location + cluster; the Secret name
# defaults to `navigator-web-secrets`.
# NAVIGATOR_GKE_CONTEXT=gke_YOUR_PROJECT_ID_YOUR_REGION_navigator-prod
# NAVIGATOR_WEB_SECRET_NAME=navigator-web-secrets

# Exact hosts rendered into the Ingress, managed certificates, redirects, and
# smoke checks. Host only: no scheme or path.
# NAVIGATOR_PUBLIC_HOST=www.your-domain.example
# NAVIGATOR_WORKFLOWS_HOST=workflows.your-domain.example

# Google Workspace hosted-domain restriction rendered into the OAuth config.
# Use the identity domain, not necessarily the site's public hostname.
# GOOGLE_OAUTH_REQUIRED_HD=your-domain.example

# Public domain override used when no custom brand bundle supplies
# `brand.primary_domain`.
# NAVIGATOR_PRIMARY_DOMAIN=www.your-domain.example

# ---------------------------------------------------------------------
# DNS — optional integration with DNSimple
# ---------------------------------------------------------------------
# Only consumed by the `navigator ops dns setup` command. Skip entirely if you
# manage DNS yourself. DNS_ZONE / DNS_ACCT are provider-agnostic (the zone and
# account to act on); DNS_SIMPLE is the preferred DNSimple credential name and
# DNSIMPLE_API_TOKEN remains a legacy alias.

# DNS_ZONE=                              # the domain to configure, e.g. neonlaw.com
# DNS_ACCT=                              # DNSimple account id (`dnsimple accounts list`)
# DNS_SIMPLE=                            # (secret)
# DNSIMPLE_API_TOKEN=                    # (secret; legacy alias)

# ---------------------------------------------------------------------
# BigQuery / archives export — nightly store → Parquet → BigQuery
# ---------------------------------------------------------------------
# Required only by the `archives` binary. Skip if you don't run the
# nightly snapshot.

# BIGQUERY_PROJECT=YOUR_PROJECT_ID
# Cloud Billing writes one export table per BILLING ACCOUNT, each carrying every
# project linked to that account. To cover several accounts, list one table per
# account, comma-separated; BillingDigest reports each and totals across them.
# BILLING_EXPORT_TABLE=YOUR_PROJECT_ID.billing_export.gcp_billing_export_v1_XXXX
# BILLING_EXPORT_TABLE=proj.billing_export.gcp_billing_export_v1_AAAA,proj.billing_export.gcp_billing_export_v1_BBBB
# BILLING_CANARY_NOTIFY_EMAIL=ops@example.com
# ARCHIVES_FAKE_TOKEN=                   # (test-only — for `wiremock`)

# ---------------------------------------------------------------------
# Test seams
# ---------------------------------------------------------------------
# Used by the browser E2E and feature suites; safe to ignore in prod.
# WEBDRIVER_URL=http://localhost:4444
# WEBDRIVER_HEADED=0
# DEVX_GCP_FAKE_TOKEN=                   # (test-only — for `wiremock`)

# CLI state and live-inquiry overrides.
# NAVIGATOR_CREDENTIALS_FILE=/tmp/navigator-credentials.json
# NAVIGATOR_CONFIG_DIR=/tmp/navigator-config
# NAVIGATOR_NOTATION_TEMPLATE=path/to/template.md
# NAVIGATOR_SPEECH_BACKEND=fake

# Harness-owned worktree/browser controls.
# NAVIGATOR_WORKTREE_PATH=/path/to/worktree
# NAVIGATOR_CHROME_CACHE_DIR=/path/to/chrome-cache
# NAV_REQUIRE_HARNESS=1
# NAV_REASK_SHOTS=1

# Engineering-only notification routing.
# SLACK_OPS_MENTION=<@U0000000000>

# Release automation credential.
# GITHUB_TOKEN=

# Xero sandbox OAuth client used only by opt-in sandbox verification.
# XERO_SANDBOX_CLIENT_ID=
# XERO_SANDBOX_CLIENT_SECRET=

# Billing digest diagnostics.
# BILLING_DIGEST_NOTIFY_EMAIL=billing@example.com
# BILLING_DIGEST_WINDOW_DAYS=7
# Identity stamped on the operator-provided integration credential set.
# Must exactly match the selected deployment: `dev` or `production`.
NAVIGATOR_CREDENTIAL_ENVIRONMENT=
